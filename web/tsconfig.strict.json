{
  // tsconfig.strict.json — the G1 tightening ratchet (T-521 / T-522).
  //
  // The root tsconfig runs `strict: false` so that migrating slices can land incrementally
  // without the build going red. This config is the opposite end: `strict: true` over an
  // explicit allow-list of directories that have already been tightened.
  //
  // The list only ever grows. `npm run typecheck:strict` gates it in CI, so a directory
  // added here can never silently regress. T-521 adds src/lib, src/types, workers and stores;
  // T-522 adds src/components and src/routes; at T-522's close the root config flips to
  // `strict: true` and this file is retired.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/types/**/*.d.ts",
    "src/stores/**/*.ts",

    // ── src/lib, file by file (T-521) ───────────────────────────────────────
    // src/lib as a whole is 4,379 errors across 260 files, so it joins one
    // file at a time rather than as a directory glob. A file can only be
    // listed once its ENTIRE import closure is clean — tsc checks whatever
    // an included file imports, so a dirty dependency fails the gate just as
    // loudly as a dirty entry. These were already clean; the rest follow as
    // they are fixed. When the list covers src/lib it collapses back to a glob.
    "src/lib/wakeState.ts",
    "src/lib/turntableRender.ts",
    "src/lib/snapshotHelpers.ts",
    "src/lib/revisionPreview.ts",
    "src/lib/heroRender.ts",
    "src/lib/zebraMaterial.ts",
    "src/lib/usageFormat.ts",
    "src/lib/threeNarrow.ts",
    "src/lib/renderStyles.ts",
    "src/lib/postEffects.ts",
    "src/lib/a11y/ariaIds.ts",
    "src/lib/a11y/focusTrap.ts",
    "src/lib/a11y/keyboardShortcuts.ts",
    "src/lib/appVersion.ts",
    "src/lib/autosaveStatusEvents.ts",
    "src/lib/buses.ts",
    "src/lib/circuitJsonPatch.ts",
    "src/lib/circuitRunner.ts",
    "src/lib/compareSearch.ts",
    "src/lib/detectAtopile.ts",
    "src/lib/detectCircuitJson.ts",
    "src/lib/detectWebGL.ts",
    "src/lib/dirtyTimer.ts",
    "src/lib/editorRouter.ts",
    "src/lib/fileTemplates.ts",
    "src/lib/hdriPresets.ts",
    "src/lib/helixGeom.ts",
    "src/lib/iesPresets.ts",
    "src/lib/jscadWorker.ts",
    "src/lib/layoutPalette.ts",
    "src/lib/localStash.ts",
    "src/lib/markdownSanitize.ts",
    "src/lib/meshCache.ts",
    "src/lib/orbitBridge.ts",
    "src/lib/padOverrides.ts",
    "src/lib/panelRegistry.ts",
    "src/lib/panels/bim-worksharing.ts",
    "src/lib/panels/entertainment.ts",
    "src/lib/plcSimBridge.ts",
    "src/lib/projectLayers.ts",
    "src/lib/revisionMeta.ts",
    "src/lib/sectorTourData.ts",
    "src/lib/sheetRevisions.ts",
    "src/lib/sketchCarbonCopy.test.ts",
    "src/lib/sketchCarbonCopy.ts",
    "src/lib/sseClient.ts",
    "src/lib/stMonacoLanguage.ts",
    "src/lib/useBreakpoint.ts",
    "src/lib/useNodeConfig.ts",
    "src/lib/usePrefersReducedMotion.ts",
    "src/lib/useViewportFit.ts",

    "src/hooks/**/*.ts",
    "src/workers/**/*.ts",
    "src/utils/**/*.ts",
    "src/illustrations/**/*.ts",
    "src/illustrations/**/*.tsx"
  ]
}
